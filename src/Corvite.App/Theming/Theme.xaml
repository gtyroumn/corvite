<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Corvite.App.Theming">

    <BooleanToVisibilityConverter x:Key="B2V"/>
    <conv:InvBoolToVisibility x:Key="InvB2V"/>

    <!-- ===== Palette (TZ section 3) ===== -->
    <SolidColorBrush x:Key="Ground" Color="#090b16"/>
    <SolidColorBrush x:Key="WinBg" Color="#090b16"/>
    <SolidColorBrush x:Key="TitleBg" Color="Transparent"/>
    <SolidColorBrush x:Key="RailBg" Color="Transparent"/>
    <SolidColorBrush x:Key="Panel" Color="#0FD7E1FF"/>
    <SolidColorBrush x:Key="Raise" Color="#29FFFFFF"/>
    <SolidColorBrush x:Key="Line" Color="#33C8D7FF"/>
    <SolidColorBrush x:Key="Fg" Color="#efeaf9"/>
    <SolidColorBrush x:Key="Fg2" Color="#b2aac9"/>
    <SolidColorBrush x:Key="Fg3" Color="#7d7595"/>
    <SolidColorBrush x:Key="Accent" Color="#8f6bf5"/>
    <SolidColorBrush x:Key="AccentHover" Color="#a487ff"/>
    <SolidColorBrush x:Key="Go" Color="#b79cff"/>
    <SolidColorBrush x:Key="Ok" Color="#3ddc84"/>
    <SolidColorBrush x:Key="Warn" Color="#e9c93f"/>
    <SolidColorBrush x:Key="Hot" Color="#f2873a"/>
    <SolidColorBrush x:Key="Stop" Color="#f04b4b"/>
    <SolidColorBrush x:Key="NavActive" Color="#29FFFFFF"/>
    <SolidColorBrush x:Key="TrackDim" Color="#B3090B16"/>
    <SolidColorBrush x:Key="Overlay" Color="#B8070510"/>


    <!-- ===== Liquid Ice: glass keys ===== -->
    <Color x:Key="GlassHiColor">#99E6EEFF</Color>
    <SolidColorBrush x:Key="GlassFill" Color="#0FD7E1FF"/>
    <SolidColorBrush x:Key="GlassChip" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="GlassSel" Color="#29FFFFFF"/>
    <SolidColorBrush x:Key="GlassSelProf" Color="#47969BFF"/>
    <SolidColorBrush x:Key="GlassGlow" Color="#806E82FF"/>
    <!-- opaque surfaces for chat, dialogs, tooltips, toast (glass would hurt readability) -->
    <SolidColorBrush x:Key="PanelSolid" Color="#E6121528"/>
    <SolidColorBrush x:Key="RaiseSolid" Color="#262b48"/>
    <SolidColorBrush x:Key="DialogBg" Color="#F2121528"/>

    <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#99E6EEFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="0.28"/>
        <GradientStop Color="#00FFFFFF" Offset="0.66"/>
        <GradientStop Color="#66FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassBody" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1AD7E1FF" Offset="0"/>
        <GradientStop Color="#0AD7E1FF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassBtn" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#29FFFFFF" Offset="0"/>
        <GradientStop Color="#08FFFFFF" Offset="0.55"/>
        <GradientStop Color="#14FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassBtnHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3AFFFFFF" Offset="0"/>
        <GradientStop Color="#16FFFFFF" Offset="0.55"/>
        <GradientStop Color="#22FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassBtnPrimary" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#8CAAAFFF" Offset="0"/>
        <GradientStop Color="#335A78FF" Offset="0.6"/>
        <GradientStop Color="#528C96FF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassBtnPrimaryHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A8BCC0FF" Offset="0"/>
        <GradientStop Color="#4A6A88FF" Offset="0.6"/>
        <GradientStop Color="#689AA4FF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#59FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8f6bf5" Offset="0"/>
        <GradientStop Color="#5b8bff" Offset="1"/>
    </LinearGradientBrush>

    <!-- glass card: used on every content card -->
    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="28"/>
        <Setter Property="Background" Value="{StaticResource GlassBody}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}"/>
        <Setter Property="BorderThickness" Value="1.2"/>
    </Style>

    <LinearGradientBrush x:Key="Ramp" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#3ddc84" Offset="0"/>
        <GradientStop Color="#a5d84a" Offset="0.30"/>
        <GradientStop Color="#e9c93f" Offset="0.55"/>
        <GradientStop Color="#f2873a" Offset="0.78"/>
        <GradientStop Color="#f04b4b" Offset="1"/>
    </LinearGradientBrush>

    <!-- Fonts: put Tektur / IBM Plex Sans / JetBrains Mono .ttf into Assets/Fonts (see README). Falls back to Segoe UI / Consolas. -->
    <FontFamily x:Key="BodyFont">pack://application:,,,/Assets/Fonts/#IBM Plex Sans, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">pack://application:,,,/Assets/Fonts/#Tektur, Segoe UI Semibold</FontFamily>
    <FontFamily x:Key="MonoFont">pack://application:,,,/Assets/Fonts/#JetBrains Mono, Consolas</FontFamily>

    <!-- ===== Buttons ===== -->
    <!-- rounded text box (AI chat input) -->
    <Style x:Key="RoundInput" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource GlassChip}"/>
        <Setter Property="Foreground" Value="{StaticResource Fg}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Fg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="999" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Go}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Fg3}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Fg}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{StaticResource GlassBtn}" BorderBrush="#42FFFFFF"
                                BorderThickness="1" CornerRadius="999" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="Sheen" Height="12" VerticalAlignment="Top" Margin="8,1,8,0" CornerRadius="999,999,0,0"
                                Background="{StaticResource GlassSheen}" Opacity="0.5" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassBtnHover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#66FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Sheen" Property="Opacity" Value="0.25"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="999" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassChip}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#66FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="UndoBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
        <Setter Property="Foreground" Value="{StaticResource Go}"/>
    </Style>

    <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{StaticResource GlassBtnPrimary}" BorderBrush="#A6D7E1FF"
                                BorderThickness="1" CornerRadius="999" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect x:Name="Glow" Color="#6E82FF" Opacity="0.42" BlurRadius="22" ShadowDepth="6" Direction="270"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="Sheen" Height="12" VerticalAlignment="Top" Margin="8,1,8,0" CornerRadius="999,999,0,0"
                                Background="{StaticResource GlassSheen}" Opacity="0.5" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassBtnPrimaryHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Sheen" Property="Opacity" Value="0.25"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter TargetName="Bd" Property="Effect" Value="{x:Null}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <!-- Language switch RU | UA | EN: Tag = "is selected" -->
    <Style x:Key="LangBtn" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Fg3}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="999" Padding="8,4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Tag" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Go}"/>
                <Setter Property="Background" Value="{StaticResource GlassSel}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ChromeBtn" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Fg3}"/>
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="13">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassSel}"/>
                            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Navigation item (rail) ===== -->
    <Style x:Key="NavBtn" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Fg2}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="999" Padding="14,10">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassChip}"/>
                            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassSel}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GlassEdge}"/>
                            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Switch (54x32, 180 ms) ===== -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="54" Height="32" Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Track" CornerRadius="16" Background="#2EFFFFFF"
                                BorderBrush="#33FFFFFF" BorderThickness="1"/>
                        <Border x:Name="Knob" Width="28" Height="24" CornerRadius="12" Background="#F5FFFFFF"
                                 HorizontalAlignment="Left" Margin="4,0,0,0">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="Tr" X="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentGrad}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="#66E6EEFF"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Tr" Storyboard.TargetProperty="X" To="22" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Tr" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Risk slider: green→red track, dimmed right of the thumb, thumb border = zone colour (Tag) ===== -->
    <Style x:Key="TrackNoneBtn" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" Height="26"/></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TrackDimBtn" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent" Height="26">
                        <Border Height="8" Background="{StaticResource TrackDim}" CornerRadius="0,4,4,0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="RiskThumb" TargetType="Thumb">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="34" Height="26" Background="Transparent">
                        <Border Width="34" Height="22" CornerRadius="11" Background="#F5FFFFFF" BorderBrush="#80FFFFFF" BorderThickness="1">
                            <Border.Effect><DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="8" ShadowDepth="2" Direction="270"/></Border.Effect>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="RiskSlider" TargetType="Slider">
        <Setter Property="Height" Value="26"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="26" Background="Transparent">
                        <Border Height="8" CornerRadius="4" Background="{StaticResource Ramp}" VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TrackNoneBtn}" Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TrackDimBtn}" Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource RiskThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Scrollbar: thin, transparent track, #3a3552 thumb (prototype: scrollbar-color) ===== -->
    <Style x:Key="ScrollPageBtn" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollThumbV" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Th" Background="#40C8D7FF" CornerRadius="4" Margin="2,0"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Th" Property="Background" Value="#70C8D7FF"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Th" Property="Background" Value="{StaticResource Go}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollThumbH" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Th" Background="#40C8D7FF" CornerRadius="4" Margin="0,2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Th" Property="Background" Value="#70C8D7FF"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Th" Property="Background" Value="{StaticResource Go}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="ScrollBarV" TargetType="ScrollBar">
        <Grid Background="Transparent" SnapsToDevicePixels="True">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollPageBtn}" Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollPageBtn}" Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumbV}"/>
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="ScrollBarH" TargetType="ScrollBar">
        <Grid Background="Transparent" SnapsToDevicePixels="True">
            <Track x:Name="PART_Track" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollPageBtn}" Command="ScrollBar.PageLeftCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollPageBtn}" Command="ScrollBar.PageRightCommand"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumbH}"/>
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <!-- implicit style: applies to every ScrollBar in the app -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="Template" Value="{StaticResource ScrollBarV}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="Template" Value="{StaticResource ScrollBarH}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Tooltip (i) ===== -->
    <Style x:Key="TipStyle" TargetType="ToolTip">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource DialogBg}" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1.2" CornerRadius="22"
                            Padding="15,14" Width="330" Margin="0,0,8,8">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.6" BlurRadius="30" ShadowDepth="8"/>
                        </Border.Effect>
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="ChoiceBtn" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Fg}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{StaticResource GlassChip}" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1" CornerRadius="22" Padding="16">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassSel}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#BFC8CDFF"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassSelProf}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- "Recommended" pill on the device-type cards -->
    <Style x:Key="RecBadge" TargetType="Border">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="Background" Value="{StaticResource Ok}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="9,3,12,3"/>
    </Style>

    <!-- Chip (risk capsule) -->
    <Style x:Key="ChipText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

</ResourceDictionary>
