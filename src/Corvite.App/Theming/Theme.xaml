<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Corvite.App.Theming">

    <BooleanToVisibilityConverter x:Key="B2V"/>
    <conv:InvBoolToVisibility x:Key="InvB2V"/>

    <!-- ===== Palette (TZ section 3) ===== -->
    <SolidColorBrush x:Key="Ground" Color="#0d0b15"/>
    <SolidColorBrush x:Key="WinBg" Color="#0d0b15"/>
    <SolidColorBrush x:Key="TitleBg" Color="Transparent"/>
    <SolidColorBrush x:Key="RailBg" Color="Transparent"/>
    <SolidColorBrush x:Key="Panel" Color="#0EFFFFFF"/>
    <SolidColorBrush x:Key="Raise" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="Line" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="Fg" Color="#efeaf9"/>
    <SolidColorBrush x:Key="Fg2" Color="#b5afc9"/>
    <SolidColorBrush x:Key="Fg3" Color="#968fb0"/>
    <SolidColorBrush x:Key="Accent" Color="#7a0dd4"/>
    <SolidColorBrush x:Key="AccentHover" Color="#8f2ae6"/>
    <SolidColorBrush x:Key="Go" Color="#b583ff"/>
    <SolidColorBrush x:Key="Ok" Color="#3ddc84"/>
    <SolidColorBrush x:Key="Warn" Color="#e9c93f"/>
    <SolidColorBrush x:Key="Hot" Color="#f2873a"/>
    <SolidColorBrush x:Key="Stop" Color="#f04b4b"/>
    <SolidColorBrush x:Key="NavActive" Color="#38B583FF"/>
    <SolidColorBrush x:Key="TrackDim" Color="#B30D0B15"/>
    <SolidColorBrush x:Key="Overlay" Color="#B8070510"/>


    <!-- ===== Liquid Ice: glass keys ===== -->
    <Color x:Key="GlassHiColor">#99E6EEFF</Color>
    <SolidColorBrush x:Key="GlassFill" Color="#0EFFFFFF"/>
    <SolidColorBrush x:Key="GlassChip" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="GlassSel" Color="#38B583FF"/>
    <SolidColorBrush x:Key="GlassSelProf" Color="#3DB583FF"/>
    <SolidColorBrush x:Key="GlassGlow" Color="#80B583FF"/>
    <!-- opaque surfaces for chat, dialogs, tooltips, toast (glass would hurt readability) -->
    <SolidColorBrush x:Key="PanelSolid" Color="#E6141126"/>
    <SolidColorBrush x:Key="RaiseSolid" Color="#2a2540"/>
    <SolidColorBrush x:Key="DialogBg" Color="#F2141126"/>

    <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2EFFFFFF" Offset="0"/><GradientStop Color="#14FFFFFF" Offset="0.5"/><GradientStop Color="#1FFFFFFF" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassBody" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#12FFFFFF" Offset="0"/><GradientStop Color="#0AFFFFFF" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassBtn" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#12FFFFFF" Offset="0"/><GradientStop Color="#08FFFFFF" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassBtnHover" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#22FFFFFF" Offset="0"/><GradientStop Color="#14FFFFFF" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassBtnPrimary" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#b583ff" Offset="0"/><GradientStop Color="#7a0dd4" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassBtnPrimaryHover" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#c49aff" Offset="0"/><GradientStop Color="#8f2ae6" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#59FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#b583ff" Offset="0"/><GradientStop Color="#7a0dd4" Offset="1"/></LinearGradientBrush>

    <!-- glass card: used on every content card -->
    <!-- violet glow rim for the main panels -->
    <LinearGradientBrush x:Key="GlowEdge" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#99C9A2FF" Offset="0"/>
        <GradientStop Color="#40B583FF" Offset="0.5"/>
        <GradientStop Color="#80A259F0" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Background" Value="{StaticResource GlassBody}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <LinearGradientBrush x:Key="Ramp" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#3ddc84" Offset="0"/>
        <GradientStop Color="#a5d84a" Offset="0.30"/>
        <GradientStop Color="#e9c93f" Offset="0.55"/>
        <GradientStop Color="#f2873a" Offset="0.78"/>
        <GradientStop Color="#f04b4b" Offset="1"/>
    </LinearGradientBrush>

    <!-- Fonts: put Tektur / IBM Plex Sans / JetBrains Mono .ttf into Assets/Fonts (see README). Falls back to Segoe UI / Consolas. -->
    <FontFamily x:Key="BodyFont">pack://application:,,,/Assets/Fonts/#IBM Plex Sans, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">pack://application:,,,/Assets/Fonts/#Tektur, Segoe UI Semibold</FontFamily>
    <FontFamily x:Key="MonoFont">pack://application:,,,/Assets/Fonts/#JetBrains Mono, Consolas</FontFamily>

    <!-- ===== Buttons ===== -->
    <!-- rounded text box (AI chat input) -->
    <Style x:Key="RoundInput" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource GlassChip}"/>
        <Setter Property="Foreground" Value="{StaticResource Fg}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Fg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Go}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Fg3}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Fg}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{StaticResource GlassBtn}" BorderBrush="#24FFFFFF"
                                BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassBtnHover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#3DFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassChip}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#3DFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="UndoBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
        <Setter Property="Foreground" Value="{StaticResource Go}"/>
    </Style>

    <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- glow lives on its own layer: an effect on the button itself would blur the text -->
                        <Border x:Name="Glow" CornerRadius="12" Background="#7a0dd4" Margin="2,4,2,0" IsHitTestVisible="False">
                            <Border.Effect><DropShadowEffect Color="#7a0dd4" Opacity="0.55" BlurRadius="18" ShadowDepth="3" Direction="270"/></Border.Effect>
                        </Border>
                        <Border x:Name="Bd" Background="{StaticResource GlassBtnPrimary}" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassBtnPrimaryHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter TargetName="Glow" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <!-- Language switch RU | UA | EN: Tag = "is selected" -->
    <Style x:Key="LangBtn" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Fg3}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="8,4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Tag" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Go}"/>
                <Setter Property="Background" Value="{StaticResource GlassSel}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ChromeBtn" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Fg3}"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassSel}"/>
                            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Navigation item (rail) ===== -->
    <Style x:Key="NavBtn" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Fg2}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="14" Padding="12,10">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassChip}"/>
                            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassSel}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#66C9A2FF"/>
                            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Switch (44x26, 180 ms) ===== -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="44" Height="26" Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Track" CornerRadius="13" Background="#1FFFFFFF"
                                BorderBrush="#14FFFFFF" BorderThickness="1"/>
                        <Border x:Name="Knob" Width="20" Height="20" CornerRadius="10" Background="#cfc9e0"
                                 HorizontalAlignment="Left" Margin="3,0,0,0">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="Tr" X="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentGrad}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="Knob" Property="Background" Value="White"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Tr" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Tr" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Risk slider: green→red track, dimmed right of the thumb, thumb border = zone colour (Tag) ===== -->
    <Style x:Key="TrackNoneBtn" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" Height="26"/></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TrackDimBtn" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent" Height="26">
                        <Border Height="8" Background="{StaticResource TrackDim}" CornerRadius="0,4,4,0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="RiskThumb" TargetType="Thumb">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="24" Height="26" Background="Transparent"><Ellipse Width="24" Height="24" Fill="#1FFFFFFF" IsHitTestVisible="False"/><Ellipse Width="18" Height="18" Fill="White"><Ellipse.Effect><DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="8" ShadowDepth="2" Direction="270"/></Ellipse.Effect></Ellipse></Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="RiskSlider" TargetType="Slider">
        <Setter Property="Height" Value="26"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="26" Background="Transparent">
                        <Border Height="8" CornerRadius="4" Background="{StaticResource Ramp}" VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TrackNoneBtn}" Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TrackDimBtn}" Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource RiskThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Scrollbar: thin, transparent track, #3a3552 thumb (prototype: scrollbar-color) ===== -->
    <Style x:Key="ScrollPageBtn" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollThumbV" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Th" Background="#40C8D7FF" CornerRadius="4" Margin="2,0"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Th" Property="Background" Value="#70C8D7FF"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Th" Property="Background" Value="{StaticResource Go}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollThumbH" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Th" Background="#40C8D7FF" CornerRadius="4" Margin="0,2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Th" Property="Background" Value="#70C8D7FF"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Th" Property="Background" Value="{StaticResource Go}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="ScrollBarV" TargetType="ScrollBar">
        <Grid Background="Transparent" SnapsToDevicePixels="True">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollPageBtn}" Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollPageBtn}" Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumbV}"/>
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="ScrollBarH" TargetType="ScrollBar">
        <Grid Background="Transparent" SnapsToDevicePixels="True">
            <Track x:Name="PART_Track" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollPageBtn}" Command="ScrollBar.PageLeftCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollPageBtn}" Command="ScrollBar.PageRightCommand"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumbH}"/>
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <!-- implicit style: applies to every ScrollBar in the app -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="Template" Value="{StaticResource ScrollBarV}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="Template" Value="{StaticResource ScrollBarH}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Tooltip (i) ===== -->
    <Style x:Key="TipStyle" TargetType="ToolTip">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource DialogBg}" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1" CornerRadius="16"
                            Padding="15,14" Width="330" Margin="0,0,8,8">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="ChoiceBtn" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Fg}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{StaticResource GlassChip}" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1" CornerRadius="14" Padding="16">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassSel}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#C9A2FF"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            <Setter TargetName="Bd" Property="Background" Value="#66B583FF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- "Recommended" pill on the device-type cards -->
    <Style x:Key="RecBadge" TargetType="Border">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="Background" Value="{StaticResource Ok}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="9,3,12,3"/>
    </Style>

    <!-- Chip (risk capsule) -->
    <Style x:Key="ChipText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

</ResourceDictionary>
