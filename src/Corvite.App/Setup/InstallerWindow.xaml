<Window x:Class="Corvite.App.Setup.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Corvite Setup" Width="720" Height="520" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource Ground}" Foreground="{StaticResource Fg}"
        FontFamily="{StaticResource BodyFont}" FontSize="14" Icon="pack://application:,,,/Assets/corvite.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <!-- same animation as the app's loading screen: the arc is drawn, the arrowhead spins in from the bottom right -->
        <Storyboard x:Key="LogoSb" Timeline.DesiredFrameRate="60" BeginTime="0:0:0.3">
            <DoubleAnimation Storyboard.TargetName="SetupArc" Storyboard.TargetProperty="StrokeDashOffset" From="17.1" To="0" Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
<DoubleAnimation Storyboard.TargetName="SetupArcGlow" Storyboard.TargetProperty="StrokeDashOffset" From="17.1" To="0" Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SetupHead" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.4" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
<DoubleAnimationUsingKeyFrames Storyboard.TargetName="SetupHeadGlow" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.4" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="SetupMove" Storyboard.TargetProperty="X" From="1000" To="0" BeginTime="0:0:1.4" Duration="0:0:1.1">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
<DoubleAnimation Storyboard.TargetName="SetupMoveG" Storyboard.TargetProperty="X" From="1000" To="0" BeginTime="0:0:1.4" Duration="0:0:1.1">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SetupMove" Storyboard.TargetProperty="Y" From="870" To="0" BeginTime="0:0:1.4" Duration="0:0:1.1">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
<DoubleAnimation Storyboard.TargetName="SetupMoveG" Storyboard.TargetProperty="Y" From="870" To="0" BeginTime="0:0:1.4" Duration="0:0:1.1">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SetupRot" Storyboard.TargetProperty="Angle" From="720" To="0" BeginTime="0:0:1.4" Duration="0:0:1.1">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
<DoubleAnimation Storyboard.TargetName="SetupRotG" Storyboard.TargetProperty="Angle" From="720" To="0" BeginTime="0:0:1.4" Duration="0:0:1.1">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <Grid.Background><SolidColorBrush Color="#0d0b15"/></Grid.Background>
            <Grid IsHitTestVisible="False" CacheMode="BitmapCache">
                <Rectangle><Rectangle.Fill><RadialGradientBrush Center="0.0,-0.05" GradientOrigin="0.0,-0.05" RadiusX="0.42" RadiusY="0.6"><GradientStop Color="#8C7A0DD4" Offset="0"/><GradientStop Color="#007A0DD4" Offset="1"/></RadialGradientBrush></Rectangle.Fill></Rectangle>
                <Rectangle><Rectangle.Fill><RadialGradientBrush Center="1.05,0.5" GradientOrigin="1.05,0.5" RadiusX="0.42" RadiusY="0.6"><GradientStop Color="#804B2A9A" Offset="0"/><GradientStop Color="#004B2A9A" Offset="1"/></RadialGradientBrush></Rectangle.Fill></Rectangle>
                <Rectangle><Rectangle.Fill><RadialGradientBrush Center="0.5,1.1" GradientOrigin="0.5,1.1" RadiusX="0.4" RadiusY="0.45"><GradientStop Color="#47A259F0" Offset="0"/><GradientStop Color="#00A259F0" Offset="1"/></RadialGradientBrush></Rectangle.Fill></Rectangle>
            </Grid>

            <!-- window buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,10,0" Panel.ZIndex="10">
                <Button WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource ChromeBtn}" Click="OnMinimize">
                    <Path Data="M1,6 H11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/>
                </Button>
                <Button WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource ChromeBtn}" Click="OnClose" IsEnabled="{Binding CanClose}">
                    <Path Data="M1.5,1.5 L10.5,10.5 M10.5,1.5 L1.5,10.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/>
                </Button>
            </StackPanel>

            <!-- ===== Page 1: options ===== -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="520" Margin="0,16,0,0"
                        Visibility="{Binding IsOptions, Converter={StaticResource B2V}}">
                <Viewbox Width="64" Height="64">
                    <Canvas Width="100" Height="100">
                        <Path Data="M75,33.4 A30,30 0 1 0 75,66.6" Stroke="#b583ff" StrokeThickness="9">
                            <Path.Effect><DropShadowEffect Color="#a259f0" BlurRadius="16" ShadowDepth="0" Opacity="0.75"/></Path.Effect>
                        </Path>
                        <Path Data="M66,28 L96,46 L70,40 Z" Fill="#b583ff">
                            <Path.Effect><DropShadowEffect Color="#a259f0" BlurRadius="12" ShadowDepth="0" Opacity="0.8"/></Path.Effect>
                        </Path>
                        <Path Data="M75,33.4 A30,30 0 1 0 75,66.6" Stroke="#b583ff" StrokeThickness="9"/>
                        <Path Data="M66,28 L96,46 L70,40 Z" Fill="#b583ff"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="{Binding Title}" HorizontalAlignment="Center" Margin="0,14,0,0" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="24"/>
                <TextBlock Text="{Binding Subtitle}" HorizontalAlignment="Center" Margin="0,4,0,18" Foreground="{StaticResource Fg2}" FontSize="13"/>

                <!-- install -->
                <Border Padding="22" Style="{StaticResource GlassCard}"
                        Visibility="{Binding IsInstall, Converter={StaticResource B2V}}">
                    <StackPanel>
                        <TextBlock Text="{Binding [loc]}" Foreground="{StaticResource Fg3}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="11"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource RoundInput}" Text="{Binding Dir, UpdateSourceTrigger=PropertyChanged}" FontSize="13"/>
                            <Button Grid.Column="1" Style="{StaticResource Btn}" Content="{Binding [browse]}" Margin="8,0,0,0" Command="{Binding BrowseCommand}"/>
                        </Grid>
                        <TextBlock Text="{Binding [existing]}" Foreground="{StaticResource Fg3}" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasExisting, Converter={StaticResource B2V}}"/>

                        <TextBlock Text="{Binding [lang]}" Foreground="{StaticResource Fg3}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="11" Margin="0,18,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource ChoiceBtn}" Tag="{Binding IsRu}" Command="{Binding SetLangCommand}" CommandParameter="ru" Margin="0,0,8,0">
                                <TextBlock Text="Русский" HorizontalAlignment="Center" FontSize="13"/>
                            </Button>
                            <Button Style="{StaticResource ChoiceBtn}" Tag="{Binding IsUk}" Command="{Binding SetLangCommand}" CommandParameter="uk" Margin="0,0,8,0">
                                <TextBlock Text="Українська" HorizontalAlignment="Center" FontSize="13"/>
                            </Button>
                            <Button Style="{StaticResource ChoiceBtn}" Tag="{Binding IsEn}" Command="{Binding SetLangCommand}" CommandParameter="en" >
                                <TextBlock Text="English" HorizontalAlignment="Center" FontSize="13"/>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Desktop}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding [desktop]}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- uninstall -->
                <Border Padding="22" Style="{StaticResource GlassCard}"
                        Visibility="{Binding IsUninstall, Converter={StaticResource B2V}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding RestoreSettings}" VerticalAlignment="Center"/>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="{Binding [rest]}"/>
                                <TextBlock Text="{Binding [rest2]}" Foreground="{StaticResource Fg3}" FontSize="11.5"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding DeleteData}" VerticalAlignment="Center"/>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="{Binding [del]}"/>
                                <TextBlock Text="{Binding [del2]}" Foreground="{StaticResource Fg3}" FontSize="11.5"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Style="{StaticResource GhostBtn}" Content="{Binding [cancel]}" Command="{Binding CancelCommand}" Margin="0,0,10,0" Padding="18,9"/>
                    <Button Style="{StaticResource PrimaryBtn}" Content="{Binding PrimaryText}" Command="{Binding RunCommand}" Padding="26,9"/>
                </StackPanel>
            </StackPanel>

            <!-- ===== Page 2 and 3: the animated logo (installing / done) ===== -->
            <Grid Visibility="{Binding ShowAnim, Converter={StaticResource B2V}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-30,0,0">
                    <Viewbox Width="130" Height="130" HorizontalAlignment="Center">
                        <Canvas Width="100" Height="100">
                            <!-- glow layer: blurred copies UNDER the crisp shapes, so the arrowhead's shadow never falls on the arc (that was the visible seam) -->
                            <Path x:Name="SetupArcGlow" Data="M75,33.4 A30,30 0 1 0 75,66.6" Stroke="#b583ff" StrokeThickness="9"
                                  StrokeDashArray="17.1 100" StrokeDashOffset="17.1">
                                <Path.Effect><DropShadowEffect Color="#a259f0" BlurRadius="16" ShadowDepth="0" Opacity="0.75"/></Path.Effect>
                            </Path>
                            <Path x:Name="SetupHeadGlow" Data="M66,28 L96,46 L70,40 Z" Fill="#b583ff" Opacity="0">
                                <Path.Effect><DropShadowEffect Color="#a259f0" BlurRadius="12" ShadowDepth="0" Opacity="0.8"/></Path.Effect>
                                <Path.RenderTransform>
                                    <TransformGroup>
                                        <RotateTransform x:Name="SetupRotG" CenterX="77" CenterY="38" Angle="720"/>
                                        <TranslateTransform x:Name="SetupMoveG" X="1000" Y="870"/>
                                    </TransformGroup>
                                </Path.RenderTransform>
                            </Path>
                            <!-- crisp layer: same colour, no effects, the arrowhead overlaps the arc, so there is nothing to show a join -->
                            <Path x:Name="SetupArc" Data="M75,33.4 A30,30 0 1 0 75,66.6" Stroke="#b583ff" StrokeThickness="9"
                                  StrokeDashArray="17.1 100" StrokeDashOffset="17.1"/>
                            <Path x:Name="SetupHead" Data="M66,28 L96,46 L70,40 Z" Fill="#b583ff" Opacity="0">
                                <Path.RenderTransform>
                                    <TransformGroup>
                                        <RotateTransform x:Name="SetupRot" CenterX="77" CenterY="38" Angle="720"/>
                                        <TranslateTransform x:Name="SetupMove" X="1000" Y="870"/>
                                    </TransformGroup>
                                </Path.RenderTransform>
                            </Path>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="C O R V I T E" Margin="0,18,0,0" HorizontalAlignment="Center" Foreground="#f3eefc"
                               FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="17"/>
                </StackPanel>

                <!-- installing: progress -->
                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,56" Visibility="{Binding IsWorking, Converter={StaticResource B2V}}">
                    <Border Width="300" Height="4" CornerRadius="2" Background="#1AFFFFFF" ClipToBounds="True">
                        <Border CornerRadius="2" Background="{StaticResource AccentGrad}" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform><ScaleTransform ScaleX="{Binding ProgressScale}"/></Border.RenderTransform>
                        </Border>
                    </Border>
                    <TextBlock Text="{Binding Status}" Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="#c9bfe0" FontFamily="{StaticResource MonoFont}" FontSize="11.5"/>
                </StackPanel>

                <!-- done -->
                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,38" Visibility="{Binding IsDone, Converter={StaticResource B2V}}">
                    <TextBlock Text="{Binding DoneTitle}" HorizontalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="18"/>
                    <TextBlock Text="{Binding DoneHint}" HorizontalAlignment="Center" Foreground="{StaticResource Fg2}" FontSize="12.5" Margin="0,4,0,14"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14" Visibility="{Binding IsInstall, Converter={StaticResource B2V}}">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding LaunchAfter}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding [launch]}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Style="{StaticResource PrimaryBtn}" Content="{Binding [finish]}" Command="{Binding FinishCommand}" Padding="40,9" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- ===== error ===== -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="460" Visibility="{Binding IsError, Converter={StaticResource B2V}}">
                <TextBlock Text="{Binding [wrong]}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="20" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource Fg2}" TextWrapping="Wrap" Margin="0,12,0,6" HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock Text="{Binding [details]}" Foreground="{StaticResource Fg3}" FontSize="11.5" HorizontalAlignment="Center"/>
                <Button Style="{StaticResource PrimaryBtn}" Content="{Binding [close]}" Command="{Binding CancelCommand}" Padding="40,9" Margin="0,20,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
