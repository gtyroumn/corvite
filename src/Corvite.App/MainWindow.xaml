<Window x:Class="Corvite.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Corvite.App.ViewModels"
        xmlns:loc="clr-namespace:Corvite.App.Localization"
        Title="Corvite" Width="1240" Height="800" MinWidth="980" MinHeight="720"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Ground}" Foreground="{StaticResource Fg}"
        FontFamily="{StaticResource BodyFont}" FontSize="14"
        Icon="Assets/corvite.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource WinBg}" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== Liquid Ice backdrop: static colour blobs under the glass panels (cached once) ===== -->
            <Grid Grid.RowSpan="3" IsHitTestVisible="False" CacheMode="BitmapCache">
                <Rectangle>
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.0,-0.05" GradientOrigin="0.0,-0.05" RadiusX="0.42" RadiusY="0.6">
                            <GradientStop Color="#8C7A0DD4" Offset="0"/><GradientStop Color="#007A0DD4" Offset="1"/>
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle>
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="1.05,0.5" GradientOrigin="1.05,0.5" RadiusX="0.42" RadiusY="0.6">
                            <GradientStop Color="#804B2A9A" Offset="0"/><GradientStop Color="#004B2A9A" Offset="1"/>
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle>
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.5,1.1" GradientOrigin="0.5,1.1" RadiusX="0.4" RadiusY="0.45">
                            <GradientStop Color="#47A259F0" Offset="0"/><GradientStop Color="#00A259F0" Offset="1"/>
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>

            <!-- ===== Title bar ===== -->
            <Border Background="{StaticResource TitleBg}">
                <Grid Margin="16,0,14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="26" Height="26">
                            <Canvas Width="100" Height="100">
                                <Path Data="M75,33.4 A30,30 0 1 0 75,66.6" Stroke="{StaticResource Go}" StrokeThickness="9"/>
                                <Path Data="M66,28 L96,46 L70,40 Z" Fill="{StaticResource Go}"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="C O R V I T E" Margin="10,0,0,0" VerticalAlignment="Center"
                                   FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="{loc:T sub}" Foreground="{StaticResource Fg3}" FontSize="12" Margin="10,2,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- AI advisor Corvi (stage 7): accent pill, first in the group so it does not blend with the language switch -->
                        <Button WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource PrimaryBtn}" Padding="14,5" Margin="0,0,18,0"
                                Command="{Binding AiToggleCommand}" ToolTip="{loc:T ai_t}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✦" FontSize="14" Margin="0,-1,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:T ai_name}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource GhostBtn}" Padding="10,4" FontSize="12" Command="{Binding PlatOpenCommand}"
                                Content="{Binding PlatformLabel}" Foreground="{StaticResource Go}" Margin="0,0,12,0"/>
                        <StackPanel Orientation="Horizontal">
                            <Button WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource LangBtn}" Content="RU" Tag="{Binding IsRu}" Command="{Binding SetLangCommand}" CommandParameter="ru"/>
                            <Button WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource LangBtn}" Content="UA" Tag="{Binding IsUk}" Command="{Binding SetLangCommand}" CommandParameter="uk"/>
                            <Button WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource LangBtn}" Content="EN" Tag="{Binding IsEn}" Command="{Binding SetLangCommand}" CommandParameter="en"/>
                        </StackPanel>
                        <Border Width="14"/>
                        <Button WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource ChromeBtn}" Click="OnMinimize">
                            <Path Data="M1,6 H11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/>
                        </Button>
                        <Button WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource ChromeBtn}" Click="OnMaximize">
                            <Rectangle Width="9" Height="9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" RadiusX="1.5" RadiusY="1.5"/>
                        </Button>
                        <Button WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource ChromeBtn}" Click="OnClose">
                            <Path Data="M1.5,1.5 L10.5,10.5 M10.5,1.5 L1.5,10.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Body ===== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="246"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource GlassCard}" BorderBrush="{StaticResource GlowEdge}" CornerRadius="22" Margin="14,2,0,14" Padding="12,16">
                    <Border.Effect><DropShadowEffect Color="#a259f0" Opacity="0.45" BlurRadius="22" ShadowDepth="0"/></Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SectionVm}">
                                <Button Style="{StaticResource NavBtn}" Tag="{Binding IsSelected}" Margin="0,0,0,2"
                                        Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Data="{Binding IconData}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="18" Height="18" Stretch="Uniform" Margin="0,0,11,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding CountText}" Foreground="{StaticResource Fg3}"
                                                   FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Grid.Row="1" Background="{StaticResource GlassChip}" BorderBrush="{StaticResource GlowEdge}" BorderThickness="1"
                            CornerRadius="14" Padding="14,10" Margin="0,10,0,0">
                        <Border.Effect><DropShadowEffect Color="#a259f0" Opacity="0.35" BlurRadius="14" ShadowDepth="0"/></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="{Binding RailTitle}" Foreground="{StaticResource Fg3}" FontFamily="{StaticResource DisplayFont}"
                                       FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="CPU" Foreground="{StaticResource Fg3}" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="0,2"/>
                                <TextBlock Grid.Column="1" Text="{Binding RailCpu}" ToolTip="{Binding RailCpu}" Foreground="{StaticResource Fg2}" FontSize="12" Margin="0,2" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="1" Text="GPU" Foreground="{StaticResource Fg3}" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RailGpu}" ToolTip="{Binding RailGpu}" Foreground="{StaticResource Fg2}" FontSize="12" Margin="0,2" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="2" Text="RAM" Foreground="{StaticResource Fg3}" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RailRam}" Foreground="{StaticResource Fg2}" FontSize="12" Margin="0,2" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ContentControl Content="{Binding CurrentPage}" Margin="22,12,26,20" MaxWidth="1100" HorizontalAlignment="Stretch"/>
                </ScrollViewer>
            </Grid>

            <!-- ===== Action bar ===== -->
            <Border Grid.Row="2" Style="{StaticResource GlassCard}" BorderBrush="{StaticResource GlowEdge}" CornerRadius="26" Margin="14,0,14,14" Padding="24,9,12,9">
                <Border.Effect><DropShadowEffect Color="#a259f0" Opacity="0.45" BlurRadius="22" ShadowDepth="0"/></Border.Effect>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Margin="0,0,10,0" Fill="{StaticResource Fg3}"/>
                        <TextBlock Text="{Binding PendingText}" Foreground="{StaticResource Fg2}" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource UndoBtn}" Content="{loc:T undo}" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" Margin="0,0,12,0"/>
                        <Button Style="{StaticResource GhostBtn}" Content="{loc:T rv}" Command="{Binding RevertCommand}" IsEnabled="{Binding CanRevert}" Margin="0,0,12,0"/>
                        <Button Style="{StaticResource PrimaryBtn}" Content="{loc:T ap}" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Toast ===== -->
            <Border Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,90"
                    Background="{StaticResource DialogBg}" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1" CornerRadius="14" Padding="18,10"
                    Visibility="{Binding ToastVisible, Converter={StaticResource B2V}}" IsHitTestVisible="False">
                <TextBlock Text="{Binding ToastText}" FontSize="13"/>
            </Border>

            <!-- ===== AI advisor chat (stage 7) ===== -->
            <Border Grid.Row="1" Grid.RowSpan="2" Width="390" Height="470" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,22,84"
                    Background="{StaticResource DialogBg}" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1" CornerRadius="22"
                    Visibility="{Binding AiOpen, Converter={StaticResource B2V}}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="16,12,10,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:T ai_t}" FontFamily="{StaticResource BodyFont}" FontWeight="SemiBold" FontSize="14.5"/>
                        </StackPanel>
                        <Button Style="{StaticResource GhostBtn}" Content="✕" Padding="8,2" HorizontalAlignment="Right" Command="{Binding AiCloseCommand}"/>
                    </Grid>
                    <ScrollViewer x:Name="ChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,0">
                        <ItemsControl ItemsSource="{Binding AiMessages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ChatMsg}">
                                    <Border Padding="12,9">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="MaxWidth" Value="300"/>
                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                                <Setter Property="Background" Value="{StaticResource RaiseSolid}"/>
                                                <Setter Property="CornerRadius" Value="18,18,18,6"/>
                                                <Setter Property="Margin" Value="0,0,36,8"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                        <Setter Property="Background" Value="#7a4fe0"/>
                                                        <Setter Property="CornerRadius" Value="18,18,6,18"/>
                                                        <Setter Property="Margin" Value="36,0,0,8"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Button Style="{StaticResource PrimaryBtn}" Content="{Binding ActionText}" Command="{Binding ActionCommand}" Padding="10,5" FontSize="12"
                                                    HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding HasAction, Converter={StaticResource B2V}}"/>
                                            <!-- checklist of proposed changes: untick what you do not want -->
                                            <ItemsControl ItemsSource="{Binding Changes.Items}" Margin="0,8,0,0"
                                                          Visibility="{Binding HasChanges, Converter={StaticResource B2V}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,7">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="12.5"/>
                                                                <TextBlock Text="{Binding Gain}" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource Fg3}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <!-- suggested next steps -->
                                            <ItemsControl ItemsSource="{Binding Chips}" Margin="0,8,0,0" Visibility="{Binding HasChips, Converter={StaticResource B2V}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:ChatBtn}">
                                                        <Grid Margin="0,0,6,6">
                                                            <Button Style="{StaticResource PrimaryBtn}" Content="{Binding Text}" Command="{Binding Command}" Padding="10,5" FontSize="12"
                                                                    Visibility="{Binding PrimaryVisibility}"/>
                                                            <Button Style="{StaticResource GhostBtn}" Content="{Binding Text}" Command="{Binding Command}" Padding="10,5" FontSize="12"
                                                                    Visibility="{Binding GhostVisibility}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Grid Grid.Row="2" Margin="14,8,14,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="ChatInput" Text="{Binding AiInput, UpdateSourceTrigger=PropertyChanged}"
                                 Foreground="{StaticResource Fg}" CaretBrush="{StaticResource Fg}" FontSize="13" VerticalContentAlignment="Center">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Border x:Name="Bd" Background="{StaticResource GlassChip}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="16,9">
                                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Go}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </TextBox.Template>
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding AiSendCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryBtn}" Width="38" Height="38" Padding="0" Margin="8,0,0,0" Command="{Binding AiSendCommand}">
                            <Path Data="M3,12 L19,12 M12,5 L19,12 L12,19" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== Red-zone dialog (TZ 7.2) ===== -->
            <Grid Grid.RowSpan="3" Background="{StaticResource Overlay}" Visibility="{Binding RedVisible, Converter={StaticResource B2V}}">
                <Border Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{StaticResource DialogBg}"
                        BorderBrush="#99f04b4b" BorderThickness="1" CornerRadius="20" Padding="20">
                    <StackPanel>
                        <TextBlock Text="{loc:T rz_t}" Foreground="{StaticResource Stop}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="17"/>
                        <TextBlock Text="{loc:T rz1}" Foreground="{StaticResource Fg2}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <ItemsControl ItemsSource="{Binding RedItems}" Margin="0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RedItem}">
                                    <Border Background="{StaticResource GlassChip}" CornerRadius="12" Padding="12,7" Margin="0,0,0,6">
                                        <Grid>
                                            <TextBlock Text="{Binding Name}" FontSize="13"/>
                                            <TextBlock Text="{Binding Value}" HorizontalAlignment="Right" Foreground="{StaticResource Stop}" FontFamily="{StaticResource MonoFont}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{loc:T rz2}" Foreground="{StaticResource Fg2}" TextWrapping="Wrap"/>
                        <CheckBox IsChecked="{Binding RedAck, Mode=TwoWay}" Margin="0,14" Foreground="{StaticResource Fg}">
                            <TextBlock Text="{loc:T ack}" FontSize="13" TextWrapping="Wrap" Margin="6,0,0,0"/>
                        </CheckBox>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource Btn}" Content="{loc:T cancel}" Command="{Binding RedCancelCommand}" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource PrimaryBtn}" Content="{loc:T ap}" Command="{Binding RedConfirmCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Manufacturer program dialog ===== -->
            <Grid Grid.RowSpan="3" Background="{StaticResource Overlay}" Visibility="{Binding ToolVisible, Converter={StaticResource B2V}}">
                <Border Width="540" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{StaticResource DialogBg}"
                        BorderBrush="{StaticResource GlassEdge}" BorderThickness="1" CornerRadius="20" Padding="24">
                    <StackPanel>
                        <TextBlock Text="{loc:T tool.t}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="18"/>
                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource Fg2}">
                            <Run Text="{loc:T tool.for}"/> <Run Text="{Binding ToolTweak, Mode=OneWay}" Foreground="{StaticResource Fg}" FontWeight="Medium"/>
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource Fg2}">
                            <Run Text="{loc:T tool.dev}"/> <Run Text="{Binding ToolDevice, Mode=OneWay}" Foreground="{StaticResource Fg}" FontFamily="{StaticResource MonoFont}"/>
                        </TextBlock>
                        <Border Background="{StaticResource GlassChip}" CornerRadius="12" Padding="16,12" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding ToolName}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="14.5"/>
                                <TextBlock Text="{Binding ToolWhy}" Foreground="{StaticResource Fg2}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource Fg3}">
                                    <Run Text="{loc:T tool.src}"/> <Run Text="{Binding ToolSource, Mode=OneWay}" FontFamily="{StaticResource MonoFont}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{loc:T tool.note}" Foreground="{StaticResource Fg3}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Style="{StaticResource Btn}" Content="{loc:T tool.close}" Command="{Binding ToolCloseCommand}" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource PrimaryBtn}" Content="{loc:T tool.open}" Command="{Binding ToolOpenCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Platform dialog (TZ 7.4) ===== -->
            <Grid Grid.RowSpan="3" Background="{StaticResource Overlay}" Visibility="{Binding PlatVisible, Converter={StaticResource B2V}}">
                <Border Width="660" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{StaticResource DialogBg}"
                        BorderBrush="{StaticResource GlassEdge}" BorderThickness="1" CornerRadius="20" Padding="24">
                    <Grid>
                        <!-- step 1: choose -->
                        <StackPanel Visibility="{Binding PlatShowChoose, Converter={StaticResource B2V}}">
                            <TextBlock Text="{loc:T pl_t}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="18"/>
                            <TextBlock Text="{loc:T pl_d}" Foreground="{StaticResource Fg2}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock Text="{loc:T pl_auto}" Foreground="{StaticResource Go}" FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="{Binding PlatAutoHint, Converter={StaticResource B2V}}"/>
                            <TextBlock Text="{Binding PlatReason}" Foreground="{StaticResource Fg3}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Visibility="{Binding PlatAutoHint, Converter={StaticResource B2V}}"/>
                            <UniformGrid Columns="2" Margin="0,6,0,0">
                                <Grid Margin="0,0,5,0">
                                    <Button Command="{Binding PlatPickCommand}" CommandParameter="pc" Margin="0,11,0,0" Tag="{Binding PlatIsPc}" Style="{StaticResource ChoiceBtn}">
                                        <StackPanel>
                                            <TextBlock Text="{loc:T pl_pc}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{loc:T pl_pcd}" Foreground="{StaticResource Fg2}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Border Style="{StaticResource RecBadge}" IsHitTestVisible="False" Visibility="{Binding PlatRecPc, Converter={StaticResource B2V}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M1,5.5 L4.2,8.8 L10,1.5" Stroke="#0b1f14" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" Width="11" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{loc:T pl_rec}" Foreground="#0b1f14" FontWeight="SemiBold" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Grid Margin="5,0,0,0">
                                    <Button Command="{Binding PlatPickCommand}" CommandParameter="laptop" Margin="0,11,0,0" Tag="{Binding PlatIsLaptop}" Style="{StaticResource ChoiceBtn}">
                                        <StackPanel>
                                            <TextBlock Text="{loc:T pl_lap}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{loc:T pl_lapd}" Foreground="{StaticResource Fg2}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Border Style="{StaticResource RecBadge}" IsHitTestVisible="False" Visibility="{Binding PlatRecLaptop, Converter={StaticResource B2V}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M1,5.5 L4.2,8.8 L10,1.5" Stroke="#0b1f14" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" Width="11" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{loc:T pl_rec}" Foreground="#0b1f14" FontWeight="SemiBold" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </UniformGrid>
                            <Border Margin="0,4,0,0" Padding="12,10" CornerRadius="12" Background="#26f2873a" BorderBrush="{StaticResource Hot}" BorderThickness="1"
                                    Visibility="{Binding PlatMismatchRisk, Converter={StaticResource B2V}}">
                                <TextBlock Text="{loc:T pl_mm_risk}" Foreground="{StaticResource Hot}" FontSize="12.5" TextWrapping="Wrap"/>
                            </Border>
                            <Border Margin="0,4,0,0" Padding="12,10" CornerRadius="12" Background="{StaticResource GlassChip}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    Visibility="{Binding PlatMismatchInfo, Converter={StaticResource B2V}}">
                                <TextBlock Text="{loc:T pl_mm_info}" Foreground="{StaticResource Fg2}" FontSize="12.5" TextWrapping="Wrap"/>
                            </Border>
                            <Button Style="{StaticResource PrimaryBtn}" Content="{loc:T pl_ok}" Command="{Binding PlatNextCommand}"
                                    IsEnabled="{Binding PlatCanNext}" HorizontalAlignment="Right" Margin="0,14,0,0"/>
                        </StackPanel>
                        <!-- step 2: mandatory warning -->
                        <StackPanel Visibility="{Binding PlatShowWarn, Converter={StaticResource B2V}}">
                            <TextBlock Text="{Binding PlatWarnTitle}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="18">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PlatIsLaptop}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Hot}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding PlatWarnText}" Foreground="{StaticResource Fg2}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="12" Background="#26f2873a" BorderBrush="{StaticResource Hot}" BorderThickness="1"
                                    Visibility="{Binding PlatMismatchRisk, Converter={StaticResource B2V}}">
                                <TextBlock Text="{loc:T pl_mm_risk}" Foreground="{StaticResource Hot}" FontSize="12.5" TextWrapping="Wrap"/>
                            </Border>
                            <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="12" Background="{StaticResource GlassChip}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    Visibility="{Binding PlatMismatchInfo, Converter={StaticResource B2V}}">
                                <TextBlock Text="{loc:T pl_mm_info}" Foreground="{StaticResource Fg2}" FontSize="12.5" TextWrapping="Wrap"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                                <Button Style="{StaticResource Btn}" Content="{loc:T pl_back}" Command="{Binding PlatBackCommand}" Margin="0,0,10,0"/>
                                <Button Style="{StaticResource PrimaryBtn}" Content="{loc:T pl_cf}" Command="{Binding PlatNextCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <!-- ===== Loading screen: light centre, dark edges; the arc draws, the arrowhead flies in from the bottom right ===== -->
            <Grid x:Name="Splash" Grid.RowSpan="3" Panel.ZIndex="100" IsHitTestVisible="{Binding SplashVisible}">
                <Grid.Background><SolidColorBrush Color="#0d0b15"/></Grid.Background>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SplashVisible}" Value="False">
                                <!-- the finished splash is cached as one bitmap, so the fade is plain compositing -->
                                <Setter Property="CacheMode"><Setter.Value><BitmapCache/></Setter.Value></Setter>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard Timeline.DesiredFrameRate="60">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.6">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" BeginTime="0:0:0.6" Duration="0">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid IsHitTestVisible="False" CacheMode="BitmapCache">
                    <Rectangle><Rectangle.Fill><RadialGradientBrush Center="0.0,-0.05" GradientOrigin="0.0,-0.05" RadiusX="0.42" RadiusY="0.6"><GradientStop Color="#8C7A0DD4" Offset="0"/><GradientStop Color="#007A0DD4" Offset="1"/></RadialGradientBrush></Rectangle.Fill></Rectangle>
                    <Rectangle><Rectangle.Fill><RadialGradientBrush Center="1.05,0.5" GradientOrigin="1.05,0.5" RadiusX="0.42" RadiusY="0.6"><GradientStop Color="#804B2A9A" Offset="0"/><GradientStop Color="#004B2A9A" Offset="1"/></RadialGradientBrush></Rectangle.Fill></Rectangle>
                    <Rectangle><Rectangle.Fill><RadialGradientBrush Center="0.5,1.1" GradientOrigin="0.5,1.1" RadiusX="0.4" RadiusY="0.45"><GradientStop Color="#47A259F0" Offset="0"/><GradientStop Color="#00A259F0" Offset="1"/></RadialGradientBrush></Rectangle.Fill></Rectangle>
                </Grid>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-30,0,0">
                    <Viewbox Width="130" Height="130" HorizontalAlignment="Center">
                        <Canvas Width="100" Height="100">
                            <!-- glow layer: blurred copies UNDER the crisp shapes, so the arrowhead's shadow never falls on the arc (that was the visible seam) -->
                            <Path x:Name="SplashArcGlow" Data="M75,33.4 A30,30 0 1 0 75,66.6" Stroke="#b583ff" StrokeThickness="9"
                                  StrokeDashArray="17.1 100" StrokeDashOffset="17.1">
                                <Path.Effect><DropShadowEffect Color="#a259f0" BlurRadius="16" ShadowDepth="0" Opacity="0.75"/></Path.Effect>
                            </Path>
                            <Path x:Name="SplashHeadGlow" Data="M66,28 L96,46 L70,40 Z" Fill="#b583ff" Opacity="0">
                                <Path.Effect><DropShadowEffect Color="#a259f0" BlurRadius="12" ShadowDepth="0" Opacity="0.8"/></Path.Effect>
                                <Path.RenderTransform>
                                    <TransformGroup>
                                        <RotateTransform x:Name="SplashRotG" CenterX="77" CenterY="38" Angle="720"/>
                                        <TranslateTransform x:Name="SplashMoveG" X="1000" Y="870"/>
                                    </TransformGroup>
                                </Path.RenderTransform>
                            </Path>
                            <!-- crisp layer: same colour, no effects, the arrowhead overlaps the arc, so there is nothing to show a join -->
                            <Path x:Name="SplashArc" Data="M75,33.4 A30,30 0 1 0 75,66.6" Stroke="#b583ff" StrokeThickness="9"
                                  StrokeDashArray="17.1 100" StrokeDashOffset="17.1"/>
                            <Path x:Name="SplashHead" Data="M66,28 L96,46 L70,40 Z" Fill="#b583ff" Opacity="0">
                                <Path.RenderTransform>
                                    <TransformGroup>
                                        <RotateTransform x:Name="SplashRot" CenterX="77" CenterY="38" Angle="720"/>
                                        <TranslateTransform x:Name="SplashMove" X="1000" Y="870"/>
                                    </TransformGroup>
                                </Path.RenderTransform>
                            </Path>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="C O R V I T E" Margin="0,18,0,0" HorizontalAlignment="Center" Foreground="#f3eefc"
                               FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="17"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,56">
                    <Border Width="260" Height="4" CornerRadius="2" Background="#1AFFFFFF" ClipToBounds="True">
                        <Border x:Name="SplashBar" CornerRadius="2" Background="{StaticResource AccentGrad}" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="SplashBarScale" ScaleX="0"/></Border.RenderTransform>
                        </Border>
                    </Border>
                    <TextBlock Text="{loc:T splash_t}" Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="#c9bfe0"
                               FontFamily="{StaticResource MonoFont}" FontSize="11.5"/>
                </StackPanel>

                <Grid.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard Timeline.DesiredFrameRate="60" BeginTime="0:0:0.3">
                                <!-- arc is drawn along its outline -->
                                <DoubleAnimation Storyboard.TargetName="SplashArc" Storyboard.TargetProperty="StrokeDashOffset" From="17.1" To="0" Duration="0:0:1.5">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
<DoubleAnimation Storyboard.TargetName="SplashArcGlow" Storyboard.TargetProperty="StrokeDashOffset" From="17.1" To="0" Duration="0:0:1.5">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <!-- arrowhead: appears off-screen at the bottom right, spins and flies diagonally into place -->
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SplashHead" Storyboard.TargetProperty="Opacity">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:1.4" Value="1"/>
                                </DoubleAnimationUsingKeyFrames>
<DoubleAnimationUsingKeyFrames Storyboard.TargetName="SplashHeadGlow" Storyboard.TargetProperty="Opacity">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:1.4" Value="1"/>
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimation Storyboard.TargetName="SplashMove" Storyboard.TargetProperty="X" From="1000" To="0" BeginTime="0:0:1.4" Duration="0:0:1.1">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
<DoubleAnimation Storyboard.TargetName="SplashMoveG" Storyboard.TargetProperty="X" From="1000" To="0" BeginTime="0:0:1.4" Duration="0:0:1.1">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="SplashMove" Storyboard.TargetProperty="Y" From="870" To="0" BeginTime="0:0:1.4" Duration="0:0:1.1">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
<DoubleAnimation Storyboard.TargetName="SplashMoveG" Storyboard.TargetProperty="Y" From="870" To="0" BeginTime="0:0:1.4" Duration="0:0:1.1">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="SplashRot" Storyboard.TargetProperty="Angle" From="720" To="0" BeginTime="0:0:1.4" Duration="0:0:1.1">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
<DoubleAnimation Storyboard.TargetName="SplashRotG" Storyboard.TargetProperty="Angle" From="720" To="0" BeginTime="0:0:1.4" Duration="0:0:1.1">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <!-- progress: creeps towards the end while loading -->
                                <DoubleAnimation Storyboard.TargetName="SplashBarScale" Storyboard.TargetProperty="ScaleX" From="0" To="0.94" Duration="0:0:7">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>
            </Grid>
        </Grid>
    </Border>
</Window>
