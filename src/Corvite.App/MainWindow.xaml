<Window x:Class="Corvite.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Corvite.App.ViewModels"
        xmlns:loc="clr-namespace:Corvite.App.Localization"
        Title="Corvite" Width="1240" Height="800" MinWidth="980" MinHeight="720"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Ground}" Foreground="{StaticResource Fg}"
        FontFamily="{StaticResource BodyFont}" FontSize="14"
        Icon="Assets/corvite.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource WinBg}" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== Title bar ===== -->
            <Border Background="{StaticResource TitleBg}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <Grid Margin="16,0,14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="26" Height="26">
                            <Canvas Width="100" Height="100">
                                <Path Data="M75,33.4 A30,30 0 1 0 75,66.6" Stroke="{StaticResource Go}" StrokeThickness="9"/>
                                <Path Data="M66,28 L96,46 L70,40 Z" Fill="{StaticResource Go}"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="C O R V I T E" Margin="10,0,0,0" VerticalAlignment="Center"
                                   FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="{loc:T sub}" Foreground="{StaticResource Fg3}" FontSize="12" Margin="10,2,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- AI advisor Corvi (stage 7): accent pill, first in the group so it does not blend with the language switch -->
                        <Button WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource PrimaryBtn}" Padding="14,5" Margin="0,0,18,0"
                                Command="{Binding AiToggleCommand}" ToolTip="{loc:T ai_t}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✦" FontSize="14" Margin="0,-1,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:T ai_name}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource GhostBtn}" Padding="10,4" FontSize="12" Command="{Binding PlatOpenCommand}"
                                Content="{Binding PlatformLabel}" Foreground="{StaticResource Go}" Margin="0,0,12,0"/>
                        <StackPanel Orientation="Horizontal">
                            <Button WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource LangBtn}" Content="RU" Tag="{Binding IsRu}" Command="{Binding SetLangCommand}" CommandParameter="ru"/>
                            <Button WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource LangBtn}" Content="UA" Tag="{Binding IsUk}" Command="{Binding SetLangCommand}" CommandParameter="uk"/>
                            <Button WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource LangBtn}" Content="EN" Tag="{Binding IsEn}" Command="{Binding SetLangCommand}" CommandParameter="en"/>
                        </StackPanel>
                        <Border Width="14"/>
                        <Button WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource ChromeBtn}" Click="OnMinimize">
                            <Path Data="M1,6 H11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/>
                        </Button>
                        <Button WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource ChromeBtn}" Click="OnMaximize">
                            <Rectangle Width="9" Height="9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" RadiusX="1.5" RadiusY="1.5"/>
                        </Button>
                        <Button WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource ChromeBtn}" Click="OnClose">
                            <Path Data="M1.5,1.5 L10.5,10.5 M10.5,1.5 L1.5,10.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Body ===== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="224"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource RailBg}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="10,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SectionVm}">
                                <Button Style="{StaticResource NavBtn}" Tag="{Binding IsSelected}" Margin="0,0,0,2"
                                        Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Data="{Binding IconData}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="18" Height="18" Stretch="Uniform" Margin="0,0,11,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding CountText}" Foreground="{StaticResource Fg3}"
                                                   FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="9" Padding="12,10" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding RailTitle}" Foreground="{StaticResource Fg3}" FontFamily="{StaticResource DisplayFont}"
                                       FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="CPU" Foreground="{StaticResource Fg3}" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="0,2"/>
                                <TextBlock Grid.Column="1" Text="{Binding RailCpu}" ToolTip="{Binding RailCpu}" Foreground="{StaticResource Fg2}" FontSize="12" Margin="0,2" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="1" Text="GPU" Foreground="{StaticResource Fg3}" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RailGpu}" ToolTip="{Binding RailGpu}" Foreground="{StaticResource Fg2}" FontSize="12" Margin="0,2" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="2" Text="RAM" Foreground="{StaticResource Fg3}" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RailRam}" Foreground="{StaticResource Fg2}" FontSize="12" Margin="0,2" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ContentControl Content="{Binding CurrentPage}" Margin="26,22,26,28" MaxWidth="1100" HorizontalAlignment="Stretch"/>
                </ScrollViewer>
            </Grid>

            <!-- ===== Action bar ===== -->
            <Border Grid.Row="2" Background="#17121f" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Margin="0,0,10,0" Fill="{StaticResource Fg3}"/>
                        <TextBlock Text="{Binding PendingText}" Foreground="{StaticResource Fg2}" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource UndoBtn}" Content="{loc:T undo}" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" Margin="0,0,12,0"/>
                        <Button Style="{StaticResource GhostBtn}" Content="{loc:T rv}" Command="{Binding RevertCommand}" IsEnabled="{Binding CanRevert}" Margin="0,0,12,0"/>
                        <Button Style="{StaticResource PrimaryBtn}" Content="{loc:T ap}" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Toast ===== -->
            <Border Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,82"
                    Background="{StaticResource Raise}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="16,10"
                    Visibility="{Binding ToastVisible, Converter={StaticResource B2V}}" IsHitTestVisible="False">
                <TextBlock Text="{Binding ToastText}" FontSize="13"/>
            </Border>

            <!-- ===== AI advisor chat (stage 7) ===== -->
            <Border Grid.Row="1" Grid.RowSpan="2" Width="390" Height="470" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,22,76"
                    Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12"
                    Visibility="{Binding AiOpen, Converter={StaticResource B2V}}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="16,12,10,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:T ai_t}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="{loc:T ai_tag}" Foreground="{StaticResource Fg3}" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="10,2,0,0"/>
                        </StackPanel>
                        <Button Style="{StaticResource GhostBtn}" Content="✕" Padding="8,2" HorizontalAlignment="Right" Command="{Binding AiCloseCommand}"/>
                    </Grid>
                    <ScrollViewer x:Name="ChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,0">
                        <ItemsControl ItemsSource="{Binding AiMessages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ChatMsg}">
                                    <Border Margin="0,0,0,8" Padding="11,8" CornerRadius="9" MaxWidth="320" HorizontalAlignment="Left" Background="{StaticResource Raise}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                        <Setter Property="Background" Value="{StaticResource Accent}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Button Style="{StaticResource PrimaryBtn}" Content="{Binding ActionText}" Command="{Binding ActionCommand}" Padding="10,5" FontSize="12"
                                                    HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding HasAction, Converter={StaticResource B2V}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Grid Grid.Row="2" Margin="14,8,14,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="ChatInput" Style="{StaticResource RoundInput}" Text="{Binding AiInput, UpdateSourceTrigger=PropertyChanged}" FontSize="13" VerticalContentAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding AiSendCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryBtn}" Content="➤" Padding="12,8" Margin="8,0,0,0" Command="{Binding AiSendCommand}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== Red-zone dialog (TZ 7.2) ===== -->
            <Grid Grid.RowSpan="3" Background="{StaticResource Overlay}" Visibility="{Binding RedVisible, Converter={StaticResource B2V}}">
                <Border Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{StaticResource Panel}"
                        BorderBrush="#7a3a3f" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="{loc:T rz_t}" Foreground="{StaticResource Stop}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="17"/>
                        <TextBlock Text="{loc:T rz1}" Foreground="{StaticResource Fg2}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <ItemsControl ItemsSource="{Binding RedItems}" Margin="0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RedItem}">
                                    <Border Background="{StaticResource Raise}" CornerRadius="7" Padding="10,7" Margin="0,0,0,6">
                                        <Grid>
                                            <TextBlock Text="{Binding Name}" FontSize="13"/>
                                            <TextBlock Text="{Binding Value}" HorizontalAlignment="Right" Foreground="{StaticResource Stop}" FontFamily="{StaticResource MonoFont}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{loc:T rz2}" Foreground="{StaticResource Fg2}" TextWrapping="Wrap"/>
                        <CheckBox IsChecked="{Binding RedAck, Mode=TwoWay}" Margin="0,14" Foreground="{StaticResource Fg}">
                            <TextBlock Text="{loc:T ack}" FontSize="13" TextWrapping="Wrap" Margin="6,0,0,0"/>
                        </CheckBox>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource Btn}" Content="{loc:T cancel}" Command="{Binding RedCancelCommand}" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource PrimaryBtn}" Content="{loc:T ap}" Command="{Binding RedConfirmCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Manufacturer program dialog ===== -->
            <Grid Grid.RowSpan="3" Background="{StaticResource Overlay}" Visibility="{Binding ToolVisible, Converter={StaticResource B2V}}">
                <Border Width="540" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{StaticResource Panel}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="22">
                    <StackPanel>
                        <TextBlock Text="{loc:T tool.t}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="18"/>
                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource Fg2}">
                            <Run Text="{loc:T tool.for}"/> <Run Text="{Binding ToolTweak, Mode=OneWay}" Foreground="{StaticResource Fg}" FontWeight="Medium"/>
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource Fg2}">
                            <Run Text="{loc:T tool.dev}"/> <Run Text="{Binding ToolDevice, Mode=OneWay}" Foreground="{StaticResource Fg}" FontFamily="{StaticResource MonoFont}"/>
                        </TextBlock>
                        <Border Background="{StaticResource Raise}" CornerRadius="8" Padding="14,12" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding ToolName}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="14.5"/>
                                <TextBlock Text="{Binding ToolWhy}" Foreground="{StaticResource Fg2}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource Fg3}">
                                    <Run Text="{loc:T tool.src}"/> <Run Text="{Binding ToolSource, Mode=OneWay}" FontFamily="{StaticResource MonoFont}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{loc:T tool.note}" Foreground="{StaticResource Fg3}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Style="{StaticResource Btn}" Content="{loc:T tool.close}" Command="{Binding ToolCloseCommand}" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource PrimaryBtn}" Content="{loc:T tool.open}" Command="{Binding ToolOpenCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Platform dialog (TZ 7.4) ===== -->
            <Grid Grid.RowSpan="3" Background="{StaticResource Overlay}" Visibility="{Binding PlatVisible, Converter={StaticResource B2V}}">
                <Border Width="660" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{StaticResource Panel}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="22">
                    <Grid>
                        <!-- step 1: choose -->
                        <StackPanel Visibility="{Binding PlatShowChoose, Converter={StaticResource B2V}}">
                            <TextBlock Text="{loc:T pl_t}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="18"/>
                            <TextBlock Text="{loc:T pl_d}" Foreground="{StaticResource Fg2}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock Text="{loc:T pl_auto}" Foreground="{StaticResource Go}" FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="{Binding PlatAutoHint, Converter={StaticResource B2V}}"/>
                            <TextBlock Text="{Binding PlatReason}" Foreground="{StaticResource Fg3}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Visibility="{Binding PlatAutoHint, Converter={StaticResource B2V}}"/>
                            <UniformGrid Columns="2" Margin="0,6,0,0">
                                <Grid Margin="0,0,5,0">
                                    <Button Command="{Binding PlatPickCommand}" CommandParameter="pc" Margin="0,11,0,0" Tag="{Binding PlatIsPc}" Style="{StaticResource ChoiceBtn}">
                                        <StackPanel>
                                            <TextBlock Text="{loc:T pl_pc}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{loc:T pl_pcd}" Foreground="{StaticResource Fg2}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Border Style="{StaticResource RecBadge}" IsHitTestVisible="False" Visibility="{Binding PlatRecPc, Converter={StaticResource B2V}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M1,5.5 L4.2,8.8 L10,1.5" Stroke="#0b1f14" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" Width="11" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{loc:T pl_rec}" Foreground="#0b1f14" FontWeight="SemiBold" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Grid Margin="5,0,0,0">
                                    <Button Command="{Binding PlatPickCommand}" CommandParameter="laptop" Margin="0,11,0,0" Tag="{Binding PlatIsLaptop}" Style="{StaticResource ChoiceBtn}">
                                        <StackPanel>
                                            <TextBlock Text="{loc:T pl_lap}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{loc:T pl_lapd}" Foreground="{StaticResource Fg2}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Border Style="{StaticResource RecBadge}" IsHitTestVisible="False" Visibility="{Binding PlatRecLaptop, Converter={StaticResource B2V}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M1,5.5 L4.2,8.8 L10,1.5" Stroke="#0b1f14" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" Width="11" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{loc:T pl_rec}" Foreground="#0b1f14" FontWeight="SemiBold" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </UniformGrid>
                            <Border Margin="0,4,0,0" Padding="12,10" CornerRadius="8" Background="#26f2873a" BorderBrush="{StaticResource Hot}" BorderThickness="1"
                                    Visibility="{Binding PlatMismatchRisk, Converter={StaticResource B2V}}">
                                <TextBlock Text="{loc:T pl_mm_risk}" Foreground="{StaticResource Hot}" FontSize="12.5" TextWrapping="Wrap"/>
                            </Border>
                            <Border Margin="0,4,0,0" Padding="12,10" CornerRadius="8" Background="{StaticResource Raise}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    Visibility="{Binding PlatMismatchInfo, Converter={StaticResource B2V}}">
                                <TextBlock Text="{loc:T pl_mm_info}" Foreground="{StaticResource Fg2}" FontSize="12.5" TextWrapping="Wrap"/>
                            </Border>
                            <Button Style="{StaticResource PrimaryBtn}" Content="{loc:T pl_ok}" Command="{Binding PlatNextCommand}"
                                    IsEnabled="{Binding PlatCanNext}" HorizontalAlignment="Right" Margin="0,14,0,0"/>
                        </StackPanel>
                        <!-- step 2: mandatory warning -->
                        <StackPanel Visibility="{Binding PlatShowWarn, Converter={StaticResource B2V}}">
                            <TextBlock Text="{Binding PlatWarnTitle}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="18">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PlatIsLaptop}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Hot}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding PlatWarnText}" Foreground="{StaticResource Fg2}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="8" Background="#26f2873a" BorderBrush="{StaticResource Hot}" BorderThickness="1"
                                    Visibility="{Binding PlatMismatchRisk, Converter={StaticResource B2V}}">
                                <TextBlock Text="{loc:T pl_mm_risk}" Foreground="{StaticResource Hot}" FontSize="12.5" TextWrapping="Wrap"/>
                            </Border>
                            <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="8" Background="{StaticResource Raise}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    Visibility="{Binding PlatMismatchInfo, Converter={StaticResource B2V}}">
                                <TextBlock Text="{loc:T pl_mm_info}" Foreground="{StaticResource Fg2}" FontSize="12.5" TextWrapping="Wrap"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                                <Button Style="{StaticResource Btn}" Content="{loc:T pl_back}" Command="{Binding PlatBackCommand}" Margin="0,0,10,0"/>
                                <Button Style="{StaticResource PrimaryBtn}" Content="{loc:T pl_cf}" Command="{Binding PlatNextCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
